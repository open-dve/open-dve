#!/bin/bash
export ODVE_UVM=${ODVE}/uvm/uvm-1.1d/
#export ODVE_UVM=${ODVE}/uvm/1800.2-2020-2.0/

# SVUnit, vendored the same way UVM is above. Used by the per-unit
# vrf/work/ut flow (agent-side ut/ folders with their own svunit.f
# filelists) - not by the UVM regressions, which never reference it.
export ODVE_SVUNIT=${ODVE}/svunit/svunit-3.38.1/
# Questa/ModelSim root, from vsim on PATH (empty if Questa isn't installed).
# MS_GCC_PATH is the gcc ModelSim ships, used by common.mk to build the UVM
# DPI library as a 32-bit object to match the 32-bit Starter Edition.
_vsim=$(command -v vsim 2>/dev/null)
export MS_HOME=${_vsim:+$(dirname "$(dirname "$_vsim")")}
case "$(uname -s)" in
    Linux*)
        # gcc-<ver>-linux: i686 toolchain. Deliberately NOT put on PATH - it
        # would shadow the host g++ that Verilator's C++ build relies on.
        export MS_GCC_PATH="$(ls -d "${MS_HOME}"/gcc-*-linux 2>/dev/null | head -1)"
        ;;
    *)
        export MS_GCC_PATH="${MS_HOME}/gcc-4.2.1-mingw32vc12"
        export PATH="${MS_GCC_PATH}/bin:${PATH}"
        ;;
esac
unset _vsim

##
# Verilator: defaults to the container-wrapped install vendored in
# script/verilator-docker/ (docker, podman or apptainer on PATH). A native
# install made by `script/verilator-docker/setup.sh --native` leaves its
# paths in native.env there and is used when nothing else is set. Set
# VERILATOR_ROOT yourself beforehand (e.g. your own native/Cygwin build)
# to override both.
#export VERILATOR_ROOT=/home/viktor/verilator/verilator
#export PATH="/cygdrive/c/cygwin64/bin:$PATH"
if [ -z "${VERILATOR_ROOT:-}" ] && [ -r "${ODVE}/script/verilator-docker/native.env" ]; then
    source "${ODVE}/script/verilator-docker/native.env"
fi
export VERILATOR_ROOT="${VERILATOR_ROOT:-${ODVE}/script/verilator-docker}"
export PATH="$VERILATOR_ROOT/bin:$PATH"
