{
  "_comment": "PHASE-0 SPIKE: hand-written stand-in for the covmap.json that covgen.py scan will generate. Flat index = base + bin; cross bins are row-major over the member points' coverage bins.",
  "format": "odve-covmap 1",
  "model": "apb_cov",
  "hash": "spike0",
  "n": 14,
  "groups": [
    {
      "name": "apb_cg",
      "source": "odve/comp/agents/apb/vrf/tb/cov/odve_cov_apb_cg.sv",
      "points": [
        {"name": "cp_len", "base": 0, "bins": ["one", "some", "big[8]", "big[16]"], "ignore": ["zero"], "illegal": ["bad"]},
        {"name": "cp_dir", "base": 4, "bins": ["rd", "wr"]}
      ],
      "crosses": [
        {"name": "x_len_dir", "base": 6, "points": ["cp_len", "cp_dir"]}
      ]
    }
  ]
}
